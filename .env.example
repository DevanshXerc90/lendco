# Copy to .env and fill in what you have. Everything has a working fallback,
# so the system runs end-to-end even with this file empty.

# Optional held-out intent comparison. Disabled unless LENDCO_LLM is enabled.
LENDCO_LLM=0
ANTHROPIC_API_KEY=
LLM_MODEL=claude-3-5-haiku-latest

# Required by Vercel/production; leave empty for local open demo mode.
API_SECRET=
DEMO_API_KEY=
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- Mock platform service base URLs (independent services) ---
CRM_URL=http://127.0.0.1:8101
PAYMENTS_URL=http://127.0.0.1:8102
SUPPORT_URL=http://127.0.0.1:8103
KNOWLEDGE_URL=http://127.0.0.1:8104
WORKFLOW_URL=http://127.0.0.1:8105

# --- Optional real integrations (auto-detected; leave empty for mock mode) ---
# CRM_BACKEND: "hubspot" or "mock"
CRM_BACKEND=
# PAYMENTS_BACKEND: "stripe", "razorpay" or "mock"
PAYMENTS_BACKEND=
HUBSPOT_ACCESS_TOKEN=
STRIPE_SECRET_KEY=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# --- API authentication (portfolio safeguards, see README "Known limitations") ---
# API_SECRET: signs borrower session tokens. Leave empty to use a per-process
# random key (tokens then reset when the API restarts; nothing is committed).
API_SECRET=
# DEMO_API_KEY: operator key for /api/borrowers and /api/scenario. Leave empty
# to run those endpoints open (demo mode - a warning is printed at startup).
DEMO_API_KEY=
# PLATFORM_API_KEY: shared key the agent sends to the internal platform
# services (X-Platform-Key). Leave empty to rely on loopback binding alone.
PLATFORM_API_KEY=

# --- Misc ---
# Deterministic seed for the synthetic data generator.
SEED=42
